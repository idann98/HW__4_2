QWidget {
    background-color: #f4f6f8;
    color: #1f2933;
    font-family: "Segoe UI";
    font-size: 14px;
}

QPushButton {
    background-color: #2c6bed;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #245cc7;
}

QPushButton:pressed {
    background-color: #1d4da2;
}

QPushButton#aboutButton {
    background-color: #5f6b78;
}

QPushButton#aboutButton:hover {
    background-color: #4b5563;
}

QPushButton#aboutButton:pressed {
    background-color: #374151;
}

QFrame {
    background-color: white;
    border: 1px solid #d9e2ec;
    border-radius: 6px;
}
